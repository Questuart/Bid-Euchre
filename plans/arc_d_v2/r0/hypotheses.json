{
  "schema_version": "hypotheses_v1",
  "rung": "r0",
  "hypotheses": [
    {
      "id": "H1",
      "description": "GBT outperforms anchor on suit contract delta (H2H)",
      "metric": "suit_delta_vs_anchor",
      "source_table": "h2h_delta_matrix.csv",
      "source_column": "net_eppd",
      "source_filter": {"challenger": "gbt_av", "opponent": "anchor_hybrid_r0_full", "facet": "suit"},
      "computation": "value",
      "expected_bound": {"op": ">", "value": 0.5},
      "surprise_if": {"op": "<", "value": 0.0}
    },
    {
      "id": "H2",
      "description": "GBT outperforms anchor on pooled net_eppd (H2H)",
      "metric": "pooled_delta_vs_anchor",
      "source_table": "h2h_delta_matrix.csv",
      "source_column": "net_eppd",
      "source_filter": {"challenger": "gbt_av", "opponent": "anchor_hybrid_r0_full", "facet": "pooled"},
      "computation": "value",
      "expected_bound": {"op": ">", "value": 0.3},
      "surprise_if": {"op": "<", "value": 0.0}
    },
    {
      "id": "H3",
      "description": "GBT high-contract delta is positive vs anchor (H2H)",
      "metric": "high_delta_vs_anchor",
      "source_table": "h2h_delta_matrix.csv",
      "source_column": "net_eppd",
      "source_filter": {"challenger": "gbt_av", "opponent": "anchor_hybrid_r0_full", "facet": "high"},
      "computation": "value",
      "expected_bound": {"op": ">", "value": 0.0},
      "surprise_if": {"op": "<", "value": -0.5}
    },
    {
      "id": "H4",
      "description": "GBT low-contract delta is non-negative vs anchor (H2H)",
      "metric": "low_delta_vs_anchor",
      "source_table": "h2h_delta_matrix.csv",
      "source_column": "net_eppd",
      "source_filter": {"challenger": "gbt_av", "opponent": "anchor_hybrid_r0_full", "facet": "low"},
      "computation": "value",
      "expected_bound": {"op": ">=", "value": -0.1},
      "surprise_if": {"op": "<", "value": -0.5}
    },
    {
      "id": "H5",
      "description": "GBT suit R-squared exceeds selected OLS suit R-squared",
      "metric": "suit_r2_advantage",
      "source_table": "model_performance.csv",
      "source_column": "r2",
      "source_filter": {"model": "gbt_av", "contract_type": "suit"},
      "comparator_filter": {"model": "selected_ols_av", "contract_type": "suit"},
      "computation": "value - comparator_value",
      "expected_bound": {"op": ">", "value": 0.0},
      "surprise_if": {"op": "<", "value": -0.05}
    },
    {
      "id": "H6",
      "description": "No model exhibits pathological pass rate (> 50%)",
      "metric": "max_pass_rate",
      "source_table": "comparator_rankings.csv",
      "source_column": "pass_rate",
      "source_filter": {"facet": "pooled"},
      "computation": "value",
      "expected_bound": {"op": "<", "value": 0.5},
      "surprise_if": {"op": ">", "value": 0.8}
    },
    {
      "id": "H7",
      "description": "GBT H2H win rate vs anchor exceeds 50%",
      "metric": "h2h_win_rate_vs_anchor",
      "source_table": "h2h_delta_matrix.csv",
      "source_column": "win_rate",
      "source_filter": {"challenger": "gbt_av", "opponent": "anchor_hybrid_r0_full"},
      "computation": "value",
      "expected_bound": {"op": ">", "value": 0.50},
      "surprise_if": {"op": "<", "value": 0.45}
    },
    {
      "id": "H8",
      "description": "Two-stage model does not regress vs selected OLS on suit",
      "metric": "two_stage_suit_delta",
      "source_table": "comparator_rankings.csv",
      "source_column": "net_eppd",
      "source_filter": {"model": "selected_two_stage_av", "facet": "suit"},
      "comparator_filter": {"model": "selected_ols_av", "facet": "suit"},
      "computation": "value - comparator_value",
      "expected_bound": {"op": ">=", "value": -0.2},
      "surprise_if": {"op": "<", "value": -1.0}
    },
    {
      "id": "H9",
      "description": "ModeloEspecifico heuristic is worst on pooled net_eppd (sanity check)",
      "metric": "heuristic_rank",
      "source_table": "comparator_rankings.csv",
      "source_column": "net_eppd",
      "source_filter": {"model": "modeloespecifico", "facet": "pooled"},
      "comparator_filter": {"model": "gbt_av", "facet": "pooled"},
      "computation": "value - comparator_value",
      "expected_bound": {"op": "<", "value": 0.0},
      "surprise_if": {"op": ">", "value": 0.5}
    }
  ]
