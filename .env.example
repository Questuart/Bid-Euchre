# Bid Euchre Browser Game — Environment Variables
# ================================================
# Copy to .env and fill in production values.
# Variables marked [REQUIRED in prod] have no safe default for production.
# See web/config.py for the authoritative HostedPlayConfig dataclass.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy connection string.  Local dev uses SQLite; production should
# point to a managed Postgres instance (e.g. Render's DATABASE_URL).
DATABASE_URL=sqlite:///hosted_play.db

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# [REQUIRED in prod] Session / cookie signing key.
# If unset, a random per-process key is generated (dev only — sessions break
# on restart, which is the desired fail-loud behavior in production).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated origin allowlist passed to CORSMiddleware via
# HostedPlayConfig.allowed_origins (wired in app.py).
# In production, restrict to your domain(s).
# Example: https://bideuchre.example.com,https://staging.bideuchre.example.com
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------------
# Public base URL used for generating shareable links.
# Must include scheme (https://) and no trailing slash.
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI Model Roster
# ---------------------------------------------------------------------------
# Default AI model identifier for new matches.
# Supported browser values:
# - "olsa" for the R3 full_ols_av ActionValueBidder
# - "bud_bot" for the R3 GBTActionValueBidder
DEFAULT_MODEL_ID=bud_bot

# Directory containing model artifact files (optional).
# Used by AIManager to resolve relative artifact paths at runtime.
# MODELS_DIR=

# Path to the OLSa (ActionValueBidder) artifact file (optional).
# Expected schema: action_value_olsa_v1
# Example: data/artifacts/arc_d_v2/r3/training_artifact_full_ols_av.json
OLSA_ARTIFACT=data/artifacts/arc_d_v2/r3/training_artifact_full_ols_av.json

# Path to the Bud Bot (GBTActionValueBidder) artifact file (optional).
# Expected schema: action_value_gbt_v1
# Example: data/artifacts/arc_d_v2/r3/training_artifact_gbt_av.json
GBT_ARTIFACT=data/artifacts/arc_d_v2/r3/training_artifact_gbt_av.json

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for uvicorn to bind on.  Render injects this automatically.
# Only needed for local Docker runs or non-Render deployments.
PORT=8000

# ---------------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------------
# Enable debug mode (verbose logging, auto-reload).
# Accepts: 1, true, yes (case-insensitive).  Anything else is false.
DEBUG=false
